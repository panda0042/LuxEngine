#include "LuxTemporalParams.h"
#include "LuxTemporal.srt.h"

STRUCT(FullscreenOutput)
{
    DATA(float4, position, SV_Position);
    DATA(float2, uv, TEXCOORD0);
};
STRUCT(TemporalOutput)
{
    DATA(float4, color, SV_Target0);
    DATA(float2, depth, SV_Target1);
#ifdef LUX_TEMPORAL_COMPOSITE
    DATA(float4, composite, SV_Target2);
#endif
};

float3 TemporalYCoCg(float3 rgb) {
    return float3(dot(rgb, float3(.25f, .5f, .25f)), (rgb.r - rgb.b) * .5f,
                  rgb.g * .5f - (rgb.r + rgb.b) * .25f);
}
float3 TemporalRgb(float3 ycc) {
    return float3(ycc.x + ycc.y - ycc.z, ycc.x + ycc.z, ycc.x - ycc.y - ycc.z);
}

float4 TemporalCubicWeights(float t) {
    const float t2 = t*t, t3 = t2*t;
    return float4(-.5f*t + t2 - .5f*t3, 1.0f - 2.5f*t2 + 1.5f*t3,
                  .5f*t + 2.0f*t2 - 1.5f*t3, -.5f*t2 + .5f*t3);
}

ROOT_SIGNATURE(DefaultRootSignature)
TemporalOutput PS_MAIN(FullscreenOutput In)
{
    INIT_MAIN;
    const int2 pixel = int2(In.position.xy);
    const int2 size = int2(gTemporal.viewport.xy);
    const float hardwareDepth = LoadTex2D(gCurrentDepth, NO_SAMPLER, pixel, 0).r;
    const float4 current = LoadTex2D(gCurrentColor, NO_SAMPLER, pixel, 0);
    const float eyeDepth = hardwareDepth < 1.0f && current.a >= 0.999f
        ? -gTemporal.up.w / max(-gTemporal.right.w - hardwareDepth, 1e-7f)
        : 0.0f;
    const bool water = eyeDepth > 0.0f && gTemporal.history.y >= 0.5f &&
        hardwareDepth < LoadTex2D(gTemporalOpaqueDepth, NO_SAMPLER, pixel, 0).r;
    TemporalOutput Out;
    Out.color = current;
    const float4 velocity = LoadTex2D(gMotionVectors, NO_SAMPLER, pixel, 0);
    const float tag = abs(velocity.w);
    Out.depth = float2(water ? -eyeDepth : eyeDepth, tag);
#ifdef LUX_TEMPORAL_COMPOSITE
    const int diagnostic = int(gTemporal.jitterDelta.z);
    const float2 displayMotion = (velocity.xy - gTemporal.jitterDelta.xy) * gTemporal.viewport.xy;
    Out.composite = diagnostic == 0 ? current : float4(0, 0, 0, 1);
    if (diagnostic == 1 && abs(velocity.w) > .5f)
        Out.composite.rgb = velocity.w < 0 ? float3(1, 0, 0) : float3(.5f + .04f * displayMotion.x, .5f + .04f * displayMotion.y, 0);
    if (diagnostic == 4 && eyeDepth > 0.0f) Out.composite.rgb = float3(1, 1, 1);
#endif
    if (eyeDepth <= 0.0f || gTemporal.history.x < 0.5f)
        RETURN(Out);

    const float2 ndc = In.uv * 2.0f - 1.0f - gTemporal.viewport.zw;
    const float3 position = eyeDepth * (gTemporal.forward.xyz + ndc.x * gTemporal.right.xyz +
                                        ndc.y * gTemporal.up.xyz);
    const float4 clip = mul(gTemporal.previousViewProjection, float4(position, 1.0f));
    if (velocity.w < -0.5f)
        RETURN(Out);
    const float expectedDepth = velocity.w > 0.5f ? velocity.z : clip.w;
    if (expectedDepth <= 0.0f)
        RETURN(Out);
    const float2 previousUv = velocity.w > 0.5f ? (In.position.xy / gTemporal.viewport.xy + velocity.xy) : clip.xy / clip.w * float2(0.5f, -0.5f) + 0.5f;
#ifdef LUX_TEMPORAL_COMPOSITE
    if (diagnostic == 1 && velocity.w == 0) {
        const float2 cameraVelocity = (previousUv - gTemporal.jitterDelta.xy) * gTemporal.viewport.xy - In.position.xy;
        Out.composite.rgb = float3(.5f+.04f*cameraVelocity.x,.5f+.04f*cameraVelocity.y,0);
    }
#endif
    const float2 previous = previousUv * gTemporal.viewport.xy - 0.5f;
    if (previous.x < 0.0f || previous.y < 0.0f ||
        previous.x > gTemporal.viewport.x - 1.0f || previous.y > gTemporal.viewport.y - 1.0f)
        RETURN(Out);

    // Reconstruct band-limited history on continuous surfaces. Across disocclusions or
    // screen edges, fall back to a renormalized footprint containing only matching samples.
    const int2 base = int2(floor(previous));
    const float2 f = previous - float2(base);
    const float4 wx = TemporalCubicWeights(f.x), wy = TemporalCubicWeights(f.y);
    const float epsilon = water ? max(0.023f, expectedDepth * 0.006f) : max(0.045f, expectedDepth * 0.012f);
    float3 cubic = float3(0, 0, 0), bilinear = float3(0, 0, 0);
    float confidence = 0.0f;
    bool continuous = true;
    UNROLL for (int j = -1; j <= 2; ++j) {
        UNROLL for (int i = -1; i <= 2; ++i) {
            const int2 q = base + int2(i, j);
            if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y) {
                continuous = false;
                continue;
            }
            const float2 d = LoadTex2D(gPreviousDepth, NO_SAMPLER, q, 0).rg;
            const float z = water ? -d.x : d.x;
            if (d.y != tag || z <= 0.0f || abs(z - expectedDepth) >= epsilon) {
                continuous = false;
                continue;
            }
            const float3 c = LoadTex2D(gPreviousColor, NO_SAMPLER, q, 0).rgb;
            cubic += c * (wx[i + 1] * wy[j + 1]);
            if (i >= 0 && i <= 1 && j >= 0 && j <= 1) {
                const float weight = (i == 0 ? 1.0f - f.x : f.x) * (j == 0 ? 1.0f - f.y : f.y);
                bilinear += c * weight;
                confidence += weight;
            }
        }
    }
    if (confidence < 0.25f)
        RETURN(Out);
    const float3 rawHistory = continuous ? max(cubic, float3(0, 0, 0)) : bilinear / confidence;
    const float motion = length((previousUv - gTemporal.jitterDelta.xy) * gTemporal.viewport.xy - In.position.xy);
    float weight = 0.0f, reactiveMask = 0.0f;
    if (water) {
        const float change = length(current.rgb - rawHistory) /
                             max(0.20f, max(length(current.rgb), length(rawHistory)));
        const float reactivity = smoothstep(0.08f, 0.36f, change);
        reactiveMask = reactivity;
#ifdef LUX_TEMPORAL_COMPOSITE
        if (diagnostic == 2) Out.composite.rgb = float3(reactivity, reactivity, reactivity);
#endif
        weight = confidence * 0.42f * (1.0f - reactivity) *
                 (1.0f - smoothstep(1.0f, 18.0f, motion));
        if (weight <= 0.001f)
            RETURN(Out);
    }

    const float3 center = TemporalYCoCg(current.rgb);
    float3 low = center, high = center, sum = center, squareSum = center * center;
    float samples = 1.0f, support = 0.0f;
    const float epsilonCurrent = max(0.02f, eyeDepth * 0.015f);
    UNROLL for (int y = -1; y <= 1; ++y)
    {
        UNROLL for (int x = -1; x <= 1; ++x)
        {
            if (x == 0 && y == 0)
                continue;
            const int2 q = clamp(pixel + int2(x, y), int2(0, 0), size - 1);
            const float depth = LoadTex2D(gCurrentDepth, NO_SAMPLER, q, 0).r;
            const float zNeighbor = -gTemporal.up.w / max(-gTemporal.right.w - depth, 1e-7f);
            const float neighborTag = abs(LoadTex2D(gMotionVectors, NO_SAMPLER, q, 0).w);
            if (depth >= 1.0f || abs(zNeighbor - eyeDepth) > epsilonCurrent || neighborTag != tag)
                continue;
            const float3 value = TemporalYCoCg(LoadTex2D(gCurrentColor, NO_SAMPLER, q, 0).rgb);
            sum += value;
            squareSum += value * value;
            samples += 1.0f;
            support += .125f;
            low = min(low, value);
            high = max(high, value);
        }
    }
    const float3 mean = sum / samples;
    const float3 deviation = sqrt(max(squareSum / samples - mean * mean, float3(0, 0, 0)));
    const float3 historical = TemporalYCoCg(rawHistory);
    const float3 extent = max(1.35f * deviation, float3(.002f, .001f, .001f));
    // Clip towards the neighborhood mean along a single ray to retain chroma.
    const float3 delta = historical - mean;
    const float3 unit = abs(delta) / extent;
    const float3 clipped = clamp(mean + delta / max(1.0f, max(unit.x, max(unit.y, unit.z))), low, high);
    if (!water) {
        const float change = length(historical - center) /
                             max(.04f, max(abs(historical.x), abs(center.x)) + deviation.x);
        const float reactive = smoothstep(.12f, .75f, change);
        reactiveMask = reactive;
        const float stable = support * (1.0f - reactive) / (1.0f + motion * .055f);
        weight = confidence * lerp(.08f, .86f, stable);
    }
    float3 resolved = lerp(center, clipped, weight);
    if (!water) {
        // Recover contrast lost to bilinear history sampling. High-pass only
        // current-frame luminance; cap it by local spread and the observed range.
        const float detail = clamp(center.x - mean.x, -.7f * deviation.x, .7f * deviation.x);
        resolved.x = clamp(resolved.x + detail * gTemporal.history.w * support * confidence,
                           low.x, high.x);
    }
    Out.color.rgb = clamp(TemporalRgb(resolved), 0.0f, 65504.0f);
#ifdef LUX_TEMPORAL_COMPOSITE
    if (diagnostic == 0) Out.composite = Out.color;
    if (diagnostic == 2) Out.composite.rgb = float3(reactiveMask, reactiveMask, reactiveMask);
    if (diagnostic == 3) Out.composite.rgb = float3(weight, weight, weight);
    if (diagnostic == 4) Out.composite.rgb = float3(1, 1, 1) * (1.0f - confidence);
#endif
    RETURN(Out);
}
