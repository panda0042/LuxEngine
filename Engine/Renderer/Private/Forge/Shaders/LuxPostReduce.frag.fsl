#include "LuxPostResources.h"

float4 ReduceTap(float2 uv) {
    float4 color = SampleLvlTex2D(gPostSource, gSamplerTrilinearClamp, uv, 0.0f);
    if (gPost.grading.w < 0.5f)
        return color;
    // Radiance is premultiplied by source coverage.
    float luma = max(PostLuma(color.rgb / max(color.a, 1e-5f)), 1e-5f);
    // Standalone flare extracts its own bright sources from the unthresholded pyramid.
    if (gPost.cameraEffects.x > 0.5f || gPost.lens.x <= 0.0f)
        return float4(color.rgb, color.a);
    float threshold = gPost.lens.y;
    float knee = max(0.5f * threshold, 1e-5f);
    float soft = clamp(luma - threshold + knee, 0.0f, 2.0f * knee);
    float gain = max(luma - threshold, soft * soft / (4.0f * knee)) / luma;
    return float4(color.rgb * gain, color.a);
}
ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(FullscreenOutput In)
{
    INIT_MAIN;
    const float2 uv = In.position.xy * gPost.dimensions.xy;
    const float2 o = gPost.dimensions.xy * 0.25f;
    const float4 a=ReduceTap(uv+o), b=ReduceTap(uv-o);
    const float4 c=ReduceTap(uv+float2(o.x,-o.y)), d=ReduceTap(uv+float2(-o.x,o.y));
    float4 weights=float4(1.0f,1.0f,1.0f,1.0f);
    if (gPost.grading.w>.5f && gPost.bloomFocus.w>0.0f) {
        const float4 lumas=float4(PostLuma(a.rgb),PostLuma(b.rgb),PostLuma(c.rgb),PostLuma(d.rgb));
        weights=1.0f/(1.0f+gPost.bloomFocus.w*lumas);
    }
    RETURN((a*weights.x+b*weights.y+c*weights.z+d*weights.w)/(weights.x+weights.y+weights.z+weights.w));
}
