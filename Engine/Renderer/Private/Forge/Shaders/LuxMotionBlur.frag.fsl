#include "LuxShutterVelocity.h"

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(ShutterInput In)
{
    INIT_MAIN;
    const int2 pixel = int2(In.position.xy);
    const int2 size = int2(gTemporal.viewport.xy);
    const float4 color = LoadTex2D(gCurrentColor, NO_SAMPLER, pixel, 0);
    const float4 motionSample = LoadTex2D(gMotionVectors, NO_SAMPLER, pixel, 0);
    if (gTemporal.history.z <= 0.0f || motionSample.w < -0.5f || color.a <= 0.0f)
        RETURN(color);
    const float depth = ShutterDepth(pixel);
    const float2 own = motionSample.w > 0.5f ? ShutterVelocity(motionSample.xy) : CameraShutterVelocity(pixel, depth);
    // A neighbor's maximum can span this pixel during the shutter. Individual taps below
    // validate both its trajectory and depth before admitting foreground radiance.
    const float2 neighborMax = LoadTex2D(gShutterTiles, NO_SAMPLER, pixel / 16, 0).xy;
    const float2 direction = dot(neighborMax, neighborMax) > dot(own, own) ? neighborMax : own;
    const float tolerance = max(0.02f, depth * .015f);
    const float speed = length(direction);
    if (speed <= .65f)
        RETURN(color);
    const int taps = min(16, max(3, int(ceil(speed))));
    float3 sum = color.rgb;
    float totalWeight = 1.0f;
    for (int i = 1; i < taps; ++i) {
        const float fraction = float(i) / float(taps - 1);
        const int2 q = clamp(int2(floor(float2(pixel) + .5f - direction * fraction)), int2(0, 0), size - 1);
        const float4 sampleColor = LoadTex2D(gCurrentColor, NO_SAMPLER, q, 0);
        const float z = ShutterDepth(q);
        const float4 neighbor = LoadTex2D(gMotionVectors, NO_SAMPLER, q, 0);
        if (sampleColor.a <= 0.0f || neighbor.w < -0.5f)
            continue;
        float3 contribution = color.rgb;
        if (z < depth - tolerance) {
            const float2 v = neighbor.w > 0.5f ? ShutterVelocity(neighbor.xy) : CameraShutterVelocity(q, z);
            const float2 traveled = float2(pixel - q);
            const float t = saturate(dot(traveled, v) / max(dot(v, v), .01f));
            if (length(traveled - t * v) < 1.3f)
                contribution = sampleColor.rgb;
        } else if (z <= depth + tolerance || dot(own, own) > .5f) {
            // A moving leading edge exposes its background during a fraction of the shutter.
            contribution = sampleColor.rgb;
        }
        sum += contribution;
        totalWeight += 1.0f;
    }
    RETURN(float4(sum / totalWeight, color.a));
}
