#include "LuxSceneResources.h"

STRUCT(ShadowOutput)
{
    DATA(float4, position, SV_Position);
    DATA(float4, color, COLOR);
    DATA(float2, uv, TEXCOORD0);
};

ROOT_SIGNATURE(DefaultRootSignature)
void PS_MAIN(ShadowOutput In)
{
    INIT_MAIN;
    if (gDraw.options.y > 0.5f &&
        BelowAlphaCutoff(SampleMaterial(gTexture, In.uv).a, In.color.a, In.uv, In.position.xy))
        discard;
    RETURN();
}
