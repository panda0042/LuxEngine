#include "LuxSceneResources.h"
#include "LuxAtmosphere.h"

STRUCT(FullscreenOutput)
{
    DATA(float4, position, SV_Position);
    DATA(float2, uv, TEXCOORD0);
};

// Port of Shaders/Sky.frag.hlsl.
ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(FullscreenOutput In)
{
    INIT_MAIN;
    const float2 p = In.uv * 2.0f - 1.0f;
    const float3 direction = normalize(gScene.forward.xyz + p.x * gScene.right.xyz + p.y * gScene.up.xyz);
    const float3 sun = normalize(-gLights.direction.xyz);
    const float3 solarIrradiance = gLights.colorIntensity.rgb * max(gLights.colorIntensity.w, 0.0f);
    float3 sky = gScene.atmosphere.x > .5f
        ? SkyScattering(direction, sun, gScene.atmosphere.w, gScene.atmosphere.y, solarIrradiance)
        : SampleLvlTexCube(gSkyEnv, gSamplerTrilinearClamp, RotateEnvironment(direction), 0.0f).rgb * gScene.environment.w;
    sky = CloudLayer(sky, direction, sun, gScene.atmosphere.z,
                     float3(gScene.weatherOrigin.z, gScene.atmosphere.w, gScene.weatherOrigin.w), solarIrradiance);
    // Keep chromaticity while fitting bright sources into the scene's FP16 attachment.
    sky /= max(1.0f, max(sky.r, max(sky.g, sky.b)) / 65504.0f);
    RETURN(float4(sky, 1.0f));
}
