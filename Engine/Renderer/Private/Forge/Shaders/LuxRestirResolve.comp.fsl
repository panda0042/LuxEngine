#include "fsl_ext.h"
#include "LuxRestirResolve.srt.h"
#include "LuxRestirResampling.h"

RestirSurface RestirLoadSurface(uint start) {
    const float4 position = gRestirCandidates[start];
    const float4 normal = gRestirCandidates[start + 1u];
    const float4 material = gRestirCandidates[start + 2u];
    RestirSurface surface;
    surface.position = position.xyz;
    surface.distance = position.w;
    surface.normal = normal.xyz;
    surface.instance = uint(normal.w);
    surface.base = material.rgb;
    surface.metallic = material.w;
    surface.roughness = gRestirCandidates[start + 3u].x;
    return surface;
}

RestirDIReservoir RestirLoadDI(uint start) {
    const float4 value = gRestirCandidates[start + 4u];
    RestirDIReservoir reservoir;
    reservoir.light = uint(value.x);
    reservoir.target = value.y;
    reservoir.weightSum = value.z;
    reservoir.count = value.w;
    return reservoir;
}

RestirGIReservoir RestirLoadGI(uint start) {
    const float4 location = gRestirCandidates[start + 5u];
    const float4 normal = gRestirCandidates[start + 6u];
    const float4 outgoing = gRestirCandidates[start + 7u];
    RestirGIReservoir reservoir;
    reservoir.proposal.positionOrDirection = location.xyz;
    reservoir.proposal.kind = location.w;
    reservoir.proposal.normal = normal.xyz;
    reservoir.target = normal.w;
    reservoir.proposal.radiance = outgoing.rgb;
    reservoir.weightSum = outgoing.w;
    reservoir.count = gRestirCandidates[start + 3u].y;
    return reservoir;
}

bool RestirCompatible(RestirSurface receiver, RestirSurface neighbor) {
    const float3 delta = neighbor.position - receiver.position;
    return neighbor.distance > 0.0f && receiver.instance == neighbor.instance &&
           dot(receiver.normal, neighbor.normal) > 0.96f &&
           abs(dot(delta, receiver.normal)) <= max(0.01f, receiver.distance * 0.0015f) &&
           abs(receiver.distance - neighbor.distance) <= max(0.03f, receiver.distance * 0.09f);
}

float3 RestirResolveGI(RestirGIReservoir reservoir, RestirSurface surface) {
    if (reservoir.target <= 0.0f || reservoir.count <= 0.0f)
        return float3(0.0f, 0.0f, 0.0f);
    const float3 origin = surface.position + surface.normal * 0.004f;
    const RestirSample proposal = reservoir.proposal;
    const float3 delta = proposal.positionOrDirection - origin;
    const float range = length(delta);
    const float3 direction = proposal.kind == 1.0f ? SafeDirection(delta, surface.normal)
                                                   : proposal.positionOrDirection;
    // Stop the ray just before the secondary surface, allowing for floating point
    // error at the receiving and sampled triangles without skipping nearby blockers.
    const float limit = proposal.kind == 1.0f ? max(range - 0.007f, 0.0011f)
                                              : gScene.rayOptions.y;
    if (RayOccluded(origin, direction, limit))
        return float3(0.0f, 0.0f, 0.0f);
    const float finalWeight = reservoir.weightSum / (reservoir.count * reservoir.target);
    return min(RestirGIContribution(proposal, surface) * finalWeight,
               float3(65504.0f, 65504.0f, 65504.0f));
}

uint ReprojectReservoir(RestirSurface surface, uint2 grid, uint spacing) {
    if (gRayHistoryParams.displacement.w < 0.5f || surface.distance <= 0.0f)
        return 0xffffffffu;
    const float3 position = surface.position + gRayHistoryParams.displacement.xyz;
    const float4 clip = mul(gRayHistoryParams.previousViewProjection, float4(position, 1.0f));
    if (clip.w <= 0.0f)
        return 0xffffffffu;
    const float2 uv = clip.xy / clip.w * float2(0.5f, -0.5f) + 0.5f;
    if (uv.x < 0.0f || uv.y < 0.0f || uv.x >= 1.0f || uv.y >= 1.0f)
        return 0xffffffffu;
    const uint2 coord = min(uint2(uv * gScene.frameSize.xy) / spacing, grid - 1u);
    const uint start = (coord.y * grid.x + coord.x) * LUX_RESTIR_HISTORY_FLOATS4;
    const float4 last = gPreviousReservoirs[start];
    const float4 normal = gPreviousReservoirs[start + 1u];
    const float4 material = gPreviousReservoirs[start + 2u];
    const float3 delta = last.xyz - position;
    const float footprint = max(length(gScene.right.xyz) * gScene.frameSize.z,
                                length(gScene.up.xyz) * gScene.frameSize.w) * float(spacing) * clip.w;
    if (last.w <= 0.0f || uint(normal.w) != surface.instance || dot(normal.xyz, surface.normal) < 0.96f ||
        length(material.rgb - surface.base) > 0.12f || abs(material.w - surface.metallic) > 0.1f ||
        abs(gPreviousReservoirs[start + 3u].x - surface.roughness) > 0.08f ||
        abs(dot(delta, surface.normal)) > max(0.015f, clip.w * 0.0015f) ||
        length(delta) > max(0.05f, 3.0f * footprint))
        return 0xffffffffu;
    return start;
}

// Effective sample counts are capped before merging, so lighting changes can replace old samples.
RestirDIReservoir ReusePreviousDI(RestirDIReservoir receiver, RestirSurface surface, uint start, uint seed) {
    const float4 previous = gPreviousReservoirs[start + 4u];
    if (previous.y <= 0.0f || previous.w <= 0.0f || uint(previous.x) >= min(gLights.count.x, 16u))
        return receiver;
    const float count = min(previous.w, 32.0f);
    const float target = RestirDITarget(uint(previous.x), surface);
    const float weight = target * (previous.z / previous.y) * (count / previous.w);
    return RestirDIUpdate(receiver, uint(previous.x), target, weight, count, RestirRandom(seed));
}

RestirGIReservoir ReusePreviousGI(RestirGIReservoir receiver, RestirSurface surface, uint start, uint seed) {
    const float previousCount = gPreviousReservoirs[start + 3u].y;
    const float4 position = gPreviousReservoirs[start + 5u];
    const float4 normal = gPreviousReservoirs[start + 6u];
    const float4 radiance = gPreviousReservoirs[start + 7u];
    if (normal.w <= 0.0f || previousCount <= 0.0f)
        return receiver;
    RestirSample proposal;
    proposal.kind = position.w;
    proposal.positionOrDirection = position.xyz;
    if (proposal.kind == 1.0f)
        proposal.positionOrDirection -= gRayHistoryParams.displacement.xyz;
    proposal.normal = normal.xyz;
    proposal.radiance = radiance.rgb;
    const float count = min(previousCount, 16.0f);
    const float target = RestirLuminance(RestirGIContribution(proposal, surface));
    const float weight = target * (radiance.w / normal.w) * (count / previousCount);
    return RestirGIUpdate(receiver, proposal, target, weight, count, RestirRandom(seed));
}

float4 FilterRaySignal(float3 sampleValue, float4 previous, float3 minimum, float3 maximum) {
    const float3 padding = 0.12f * max(maximum, float3(0.1f, 0.1f, 0.1f));
    const float3 past = clamp(previous.rgb, minimum - padding, maximum + padding);
    const float count = min(12.0f, previous.w + 1.0f);
    return float4(lerp(past, sampleValue, rcp(max(count, 1.0f))), count);
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) threadId)
{
    INIT_MAIN;
    const uint2 size = uint2(gScene.frameSize.xy);
    const uint2 grid = RestirGrid(size, RestirSpacing(size));
    if (threadId.x >= grid.x || threadId.y >= grid.y) {
        RETURN();
    }
    const uint cell = threadId.y * grid.x + threadId.x;
    const uint start = cell * LUX_RESTIR_CANDIDATE_FLOATS4;
    const RestirSurface surface = RestirLoadSurface(start);
    RestirDIReservoir direct = RestirLoadDI(start);
    RestirGIReservoir indirect = RestirLoadGI(start);
    const uint previous = ReprojectReservoir(surface, grid, RestirSpacing(size));
    const bool denoise = gRayHistoryParams.controls.z > 0.5f;
    const float4 glossy = gRestirCandidates[start + 8u];
    float3 specSum = glossy.rgb, specMin = glossy.rgb, specMax = glossy.rgb;
    float specWeight = glossy.w;
    if (surface.distance > 0.0f) {
        const uint effects = uint(gScene.rayOptions.x);
        const uint seed = RestirHash(cell ^ 0x444055b1u ^ RestirHash(uint(gRayHistoryParams.controls.x)));
        if (previous != 0xffffffffu && gRayHistoryParams.controls.y > 0.5f) {
            if ((effects & LUX_RESTIR_DI) != 0u)
                direct = ReusePreviousDI(direct, surface, previous, seed + 17u);
            if ((effects & LUX_RESTIR_GI) != 0u)
                indirect = ReusePreviousGI(indirect, surface, previous, seed + 19u);
        }
        const int scale = 1 + int(RestirHash(seed + 1u) & 1u);
        for (uint i = 0u; i < 4u; ++i) {
            const int2 delta = i < 2u ? int2(i == 0u ? -scale : scale, 0)
                                      : int2(0, i == 2u ? -scale : scale);
            const int2 coordinate = int2(threadId.xy) + delta;
            if (coordinate.x < 0 || coordinate.y < 0 ||
                coordinate.x >= int(grid.x) || coordinate.y >= int(grid.y))
                continue;
            const uint neighbor = (uint(coordinate.y) * grid.x + uint(coordinate.x)) *
                                  LUX_RESTIR_CANDIDATE_FLOATS4;
            const RestirSurface neighborSurface = RestirLoadSurface(neighbor);
            if (!RestirCompatible(surface, neighborSurface))
                continue;
            if (denoise && glossy.w > 0.0f) {
                const float4 sampleValue = gRestirCandidates[neighbor + 8u];
                const float weight = sampleValue.w * exp(-32.0f * abs(surface.roughness - neighborSurface.roughness)) *
                                     pow(saturate(dot(surface.normal, neighborSurface.normal)), 32.0f);
                if (weight > 0.01f) {
                    specSum += sampleValue.rgb * weight;
                    specWeight += weight;
                    specMin = min(specMin, sampleValue.rgb);
                    specMax = max(specMax, sampleValue.rgb);
                }
            }
            if ((effects & LUX_RESTIR_DI) != 0u) {
                const RestirDIReservoir donor = RestirLoadDI(neighbor);
                if (donor.target > 0.0f) {
                    const float target = RestirDITarget(donor.light, surface);
                    // Reservoir reuse re-evaluates the selected sample's target
                    // on the receiving surface before combining its effective count.
                    const float weight = target * donor.weightSum / donor.target;
                    direct = RestirDIUpdate(direct, donor.light, target, weight, donor.count,
                                            RestirRandom(seed + i * 2u));
                } else {
                    direct.count += donor.count;
                }
            }
            if ((effects & LUX_RESTIR_GI) != 0u || (denoise && (effects & 8u) != 0u)) {
                const RestirGIReservoir donor = RestirLoadGI(neighbor);
                if (donor.target > 0.0f) {
                    const float target = RestirLuminance(RestirGIContribution(donor.proposal, surface));
                    const float weight = target * donor.weightSum / donor.target;
                    indirect = RestirGIUpdate(indirect, donor.proposal, target, weight,
                                               donor.count, RestirRandom(seed + i * 2u + 1u));
                } else {
                    indirect.count += donor.count;
                }
            }
        }
    }
    const float directWeight = direct.target > 0.0f
                                   ? direct.weightSum / (direct.count * direct.target)
                                   : 0.0f;
    const uint outputIndex = cell * LUX_RESTIR_OUTPUT_FLOATS4;
    gRestirResult[outputIndex] = float4(surface.position, surface.distance);
    gRestirResult[outputIndex + 1u] = float4(surface.normal, 0.0f);
    gRestirResult[outputIndex + 2u] =
        float4(float(direct.light), directWeight, direct.count, 0.0f);
    const float3 indirectLighting = RestirResolveGI(indirect, surface);
    float4 filteredGI = float4(indirectLighting, indirect.count > 0.0f ? 1.0f : 0.0f);
    float4 filteredSpec = float4(specSum / max(1.0f, specWeight), glossy.w);
    if (denoise && previous != 0xffffffffu) {
        if (filteredGI.w > 0.0f)
            filteredGI = FilterRaySignal(filteredGI.rgb, gPreviousReservoirs[previous + 9u],
                                          filteredGI.rgb * 0.35f, filteredGI.rgb * 2.5f + 0.15f);
        if (filteredSpec.w > 0.0f)
            filteredSpec = FilterRaySignal(filteredSpec.rgb, gPreviousReservoirs[previous + 8u], specMin, specMax);
    }
    gRestirResult[outputIndex + 3u] = float4(filteredGI.rgb, indirect.count);
    gRestirResult[outputIndex + 4u] = filteredSpec;

    // Pure spatial resampling binds two minimal valid buffer views.
    if (!denoise && gRayHistoryParams.controls.y < 0.5f)
        RETURN();
    const uint next = cell * LUX_RESTIR_HISTORY_FLOATS4;
    gNextReservoirs[next] = float4(surface.position, surface.distance);
    gNextReservoirs[next + 1u] = float4(surface.normal, float(surface.instance));
    gNextReservoirs[next + 2u] = float4(surface.base, surface.metallic);
    gNextReservoirs[next + 3u] = float4(surface.roughness, indirect.count, 0.0f, 0.0f);
    gNextReservoirs[next + 4u] = float4(float(direct.light), direct.target, direct.weightSum, direct.count);
    gNextReservoirs[next + 5u] = float4(indirect.proposal.positionOrDirection, indirect.proposal.kind);
    gNextReservoirs[next + 6u] = float4(indirect.proposal.normal, indirect.target);
    gNextReservoirs[next + 7u] = float4(indirect.proposal.radiance, indirect.weightSum);
    gNextReservoirs[next + 8u] = filteredSpec;
    gNextReservoirs[next + 9u] = filteredGI;
    RETURN();
}
